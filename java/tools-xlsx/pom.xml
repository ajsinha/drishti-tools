<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.tools</groupId>
    <artifactId>tools-parent</artifactId>
    <version>1.2.0-SNAPSHOT</version>
  </parent>
  <artifactId>tools-xlsx</artifactId>
  <name>Drishti Tools: tools-xlsx</name>
  <properties>
    <tools.java.root>${project.basedir}/..</tools.java.root>
    <automatic.module.name>com.ash.tools.xlsx</automatic.module.name>
  </properties>
  <description>The one .xlsx writer: streaming sheets, styles, formulas, charts, templates. JDK only; Apache POI is its test oracle.</description>

  <dependencies>
    <dependency><groupId>org.apache.poi</groupId><artifactId>poi-ooxml</artifactId><scope>test</scope></dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludes><exclude>**/LargeStreamTest.java</exclude></excludes>
        </configuration>
        <executions>
          <!-- a million cells under a 64 MB heap, in a JVM of its own: the writer must stream -->
          <execution>
            <id>large-stream</id>
            <goals><goal>test</goal></goals>
            <configuration>
              <excludes combine.self="override"/>
              <includes><include>**/LargeStreamTest.java</include></includes>
              <forkCount>1</forkCount>
              <reuseForks>false</reuseForks>
              <argLine>-Xmx64m -Djava.io.tmpdir=${project.build.directory}/tmp</argLine>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
