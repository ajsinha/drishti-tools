<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.tools</groupId>
    <artifactId>tools-parent</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>tools-guards</artifactId>
  <name>Drishti Tools: tools-guards</name>
  <description>The repository's guards (published as a test jar: its kit package): API surface additive-only, domain words, product names, dependencies, module rules, header and line cap.</description>

  <properties>
    <tools.api.surface.write>false</tools.api.surface.write>
  </properties>
  <dependencies>
    <!-- test scope: the API surface guard loads every module's compiled classes -->
    <dependency><groupId>com.ash.tools</groupId><artifactId>tools-settings</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>com.ash.tools</groupId><artifactId>tools-net</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>com.ash.tools</groupId><artifactId>tools-concurrent</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>com.ash.tools</groupId><artifactId>tools-time</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>com.ash.tools</groupId><artifactId>tools-xlsx</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>com.ash.tools</groupId><artifactId>tools-codec</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>com.ash.tools</groupId><artifactId>tools-csv</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>com.ash.tools</groupId><artifactId>tools-files</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>com.ash.tools</groupId><artifactId>tools-testkit</artifactId><version>${project.version}</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <goals><goal>test-jar</goal></goals>
            <configuration>
              <!-- the classes only (the kit): this repository's own lists stay out, a consumer has its own -->
              <includes><include>com/ash/tools/guards/kit/**</include></includes>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <tools.api.surface.write>${tools.api.surface.write}</tools.api.surface.write>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
