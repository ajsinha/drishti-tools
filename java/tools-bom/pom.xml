<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.ash.tools</groupId>
  <artifactId>tools-bom</artifactId>
  <version>1.2.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Drishti Tools: the bill of materials (one version for every module)</name>
  <description>Import it in a consumer's dependencyManagement (scope import) and name the modules without versions.</description>

  <dependencyManagement>
    <dependencies>
      <dependency><groupId>com.ash.tools</groupId><artifactId>tools-settings</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.ash.tools</groupId><artifactId>tools-net</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.ash.tools</groupId><artifactId>tools-concurrent</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.ash.tools</groupId><artifactId>tools-time</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.ash.tools</groupId><artifactId>tools-xlsx</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.ash.tools</groupId><artifactId>tools-codec</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.ash.tools</groupId><artifactId>tools-csv</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.ash.tools</groupId><artifactId>tools-files</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.ash.tools</groupId><artifactId>tools-testkit</artifactId><version>${project.version}</version></dependency>
      <!-- the guards, published as a test jar: a consumer's guard module names it with scope test -->
      <dependency><groupId>com.ash.tools</groupId><artifactId>tools-guards</artifactId><version>${project.version}</version><type>test-jar</type></dependency>
    </dependencies>
  </dependencyManagement>
</project>
